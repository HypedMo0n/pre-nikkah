{
  "name": "prenikkah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:lint": "npx supabase db lint --local --level warning",
    "db:remote:lint": "node scripts/db/remote-db.mjs lint",
    "db:remote:push": "node scripts/db/remote-db.mjs push",
    "db:remote:seed": "node scripts/db/remote-db.mjs seed",
    "db:remote:test": "node scripts/db/remote-db.mjs test",
    "db:remote:verify": "node scripts/db/remote-db.mjs verify",
    "db:reset": "npx supabase db reset",
    "db:start": "npx supabase start",
    "db:test": "npx supabase test db",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test tests/e2e/mobile-matrix.spec.ts tests/e2e/mobile-device.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "qr-scanner": "^1.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.82.0",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.2.10",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "postgres": "^3.4.9",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
